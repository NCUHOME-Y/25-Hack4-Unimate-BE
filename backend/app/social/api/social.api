syntax = "v1"

info (
	title:   "Social Service"
	desc:    "社交服务，包括帖子、评论、点赞、排行榜、聊天等"
	author:  "Unimate"
	version: "v1"
)

type (
	// 帖子
	PostItem {
		Id         uint          `json:"id"`
		Title      string        `json:"title"`
		Content    string        `json:"content"`
		Like       int           `json:"like"`
		UserId     uint          `json:"user_id"`
		UserName   string        `json:"userName"`
		UserAvatar string        `json:"userAvatar"`
		CreatedAt  string        `json:"created_at"`
		Comments   []CommentItem `json:"comments"`
	}
	CommentItem {
		Id         uint   `json:"id"`
		PostId     uint   `json:"post_id"`
		UserId     uint   `json:"userId"`
		UserName   string `json:"userName"`
		UserAvatar string `json:"userAvatar"`
		Content    string `json:"content"`
		CreatedAt  string `json:"created_at"`
	}
	GetAllPostsResp {
		Posts []PostItem `json:"posts"`
	}
	PostUserPostReq {
		Title   string `json:"title"`
		Content string `json:"content"`
		FlagId  uint   `json:"flag_id,optional"`
	}
	DeleteUserPostReq {
		Id uint `json:"id"`
	}
	LikePostReq {
		PostId uint `json:"post_id"`
	}
	CommentOnPostReq {
		PostId  uint   `json:"post_id"`
		Content string `json:"content"`
	}
	DeleteCommentReq {
		CommentId uint `json:"comment_id"`
	}
	// Flag 互动
	LikeFlagReq {
		FlagId uint `json:"flag_id"`
	}
	CommentOnFlagReq {
		FlagId  uint   `json:"flag_id"`
		Content string `json:"content"`
	}
	DeleteFlagCommentReq {
		CommentId uint `json:"comment_id"`
	}
	// 聊天
	ChatRoom {
		Id   string `json:"id"`
		Name string `json:"name"`
	}
	CreateChatRoomReq {
		Name string `json:"name"`
	}
	DeleteChatRoomReq {
		RoomId string `path:"room_id"`
	}
	ChatMessage {
		Id         uint   `json:"id"`
		FromUserId uint   `json:"from"`
		ToUserId   uint   `json:"to"`
		RoomId     string `json:"room_id"`
		Content    string `json:"content"`
		CreatedAt  string `json:"created_at"`
		UserName   string `json:"user_name"`
		UserAvatar string `json:"user_avatar"`
	}
	GetChatHistoryResp {
		Messages []ChatMessage `json:"messages"`
	}
	// 排行榜
	RankingItem {
		UserId   uint   `json:"user_id"`
		Name     string `json:"name"`
		HeadShow int    `json:"head_show"`
		Value    int    `json:"value"` // 可能是flag数、积分、时长等
	}
	RankingResp {
		List []RankingItem `json:"list"`
	}
	SearchPostsReq {
		Keyword string `json:"keyword"`
	}
)

@server (
	prefix: api
)
service social-api {
	@handler GetAllPosts
	get /getAllPosts returns (GetAllPostsResp)

	@handler GetVisibleFlags
	get /getflag returns (GetAllPostsResp) // 复用结构，实际返回Flag列表

	// 排行榜 (公开)
	@handler GetUserByFlagNumber
	get /getUseflagrRank returns (RankingResp)

	@handler GetUserCount
	get /countranking returns (RankingResp)

	@handler GetUserMonthLearnTime
	get /learnTimeRanking returns (RankingResp)

	@handler GetUserTotalDaka
	get /dakaRanking returns (RankingResp)
}

@server (
	jwt:    Auth
	prefix: api
)
service social-api {
	// 帖子互动
	@handler LikePost
	post /likepost (LikePostReq) returns (GetAllPostsResp) // 简化返回

	@handler GetPostLikes
	get /getpostlike returns (GetAllPostsResp)

	@handler GetUserLikedPosts
	get /getUserLikedPosts returns (GetAllPostsResp)

	@handler PostUserPost
	post /postUserPost (PostUserPostReq) returns (GetAllPostsResp)

	@handler DeleteUserPost
	delete /deleteUserPost (DeleteUserPostReq) returns (GetAllPostsResp)

	@handler CommentOnPost
	post /commentOnPost (CommentOnPostReq) returns (GetAllPostsResp)

	@handler DeleteUserPostComment
	delete /deleteComment (DeleteCommentReq) returns (GetAllPostsResp)

	@handler SearchPosts
	post /searchPosts (SearchPostsReq) returns (GetAllPostsResp)

	// Flag 互动
	@handler LikeFlag
	post /likeFlag (LikeFlagReq) returns (GetAllPostsResp)

	@handler CommentOnFlag
	post /flagcomment (CommentOnFlagReq) returns (GetAllPostsResp)

	@handler DeleteFlagComment
	delete /flagdeletecomment (DeleteFlagCommentReq) returns (GetAllPostsResp)

	@handler GetFlagLikes
	get /getflaglike returns (GetAllPostsResp)

	// 聊天
	@handler WsHandler
	get /ws/chat

	@handler GetChatRooms
	get /chat/rooms returns ([]ChatRoom)

	@handler CreateChatRoom
	post /chat/rooms (CreateChatRoomReq) returns (ChatRoom)

	@handler DeleteChatRoom
	delete /chat/rooms/:room_id (DeleteChatRoomReq) returns (GetAllPostsResp)

	@handler GetChatHistory
	get /chat/history/:room_id returns (GetChatHistoryResp)

	@handler GetPrivateChatHistory
	get /private-chat/history returns (GetChatHistoryResp)

	@handler GetPrivateConversations
	get /private-chat/conversations returns (GetChatHistoryResp)
}

